---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogPostLayout from '@/components/blog/BlogPostLayout.astro';
import LiquidGlassButton from '@/components/ui/LiquidGlassButton.astro';
import { supabase } from '@/lib/supabase';
import '@/styles/global.css';
import '@/styles/blog.css';

export async function getStaticPaths() {
  const { data } = await supabase
    .from('blog_posts')
    .select('slug')
    .eq('published', true);

  return (data || []).map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;

let post = null;
try {
  const { data, error } = await supabase
    .from('blog_posts')
    .select('*')
    .eq('slug', slug)
    .eq('published', true)
    .maybeSingle();

  if (error) throw error;
  post = data;
} catch (e) {
  console.error('Supabase fetch error for blog post:', e);
}

if (!post) {
  return Astro.redirect('/404');
}

const breadcrumbs = [
  { name: 'Acasa', href: '/' },
  { name: 'Resurse', href: '/resurse' },
  { name: 'Blog', href: '/resurse#blog' },
  { name: post.title.length > 40 ? post.title.slice(0, 40) + '...' : post.title, href: `/resurse/blog/${post.slug}` },
];
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  image={`https://mindleap.ro${post.cover_image}`}
  type="article"
  publishedTime={post.date_published}
  modifiedTime={post.date_published}
  breadcrumbs={breadcrumbs}
>
  <BlogPostLayout post={post}>
    <Fragment set:html={post.content} />

    <aside class="blog-cta-card blog-glass">
      <h2>Hai sa discutam despre strategia ta</h2>
      <p>
        La Mindleap, construim ecosisteme de marketing care functioneaza — strategie, executie si crestere reala pentru afaceri din Romania.
      </p>
      <div class="blog-cta-actions">
        <LiquidGlassButton href="/contact" variant="glass-primary">
          Programeaza o discutie
        </LiquidGlassButton>
        <LiquidGlassButton href="/servicii" variant="glass-secondary">
          Vezi serviciile
        </LiquidGlassButton>
      </div>
    </aside>
  </BlogPostLayout>
</BaseLayout>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.excerpt,
  "image": `https://mindleap.ro${post.cover_image}`,
  "datePublished": post.date_published,
  "author": { "@type": "Person", "name": post.author },
  "publisher": { "@type": "Organization", "name": "Mindleap", "url": "https://mindleap.ro" },
  "mainEntityOfPage": `https://mindleap.ro/resurse/blog/${post.slug}`,
})} />
