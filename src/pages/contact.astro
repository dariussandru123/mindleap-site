---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import LiquidGlassButton from '@/components/ui/LiquidGlassButton.astro';
import '@/styles/global.css';

const breadcrumbs = [
  { name: 'Acasă', href: '/' },
  { name: 'Contact', href: '/contact' },
];

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://mindleap.ro';
const contactEmail = 'hello@mindleap.ro';
const contactName = 'Codoban Ioan';
const address = {
  ...SITE.address,
  fullAddress: `${SITE.address.street}, ${SITE.address.city} ${SITE.address.postalCode}, ${SITE.address.country}`,
};

const whatsappLink = `https://wa.me/${SITE.whatsapp}`;

const socialLinks = [
  { name: 'Facebook', icon: 'ti-brand-facebook', href: SITE.social.facebook },
  { name: 'Instagram', icon: 'ti-brand-instagram', href: SITE.social.instagram },
  { name: 'LinkedIn', icon: 'ti-brand-linkedin', href: SITE.social.linkedin },
  { name: 'TikTok', icon: 'ti-brand-tiktok', href: SITE.social.tiktok },
];

const faqs = [
  {
    question: 'Cât costă o consultație inițială?',
    answer: 'Prima discuție este gratuită. O folosim ca să înțelegem businessul tău și să vedem dacă putem ajuta, fără nicio obligație.',
  },
  {
    question: 'În cât timp primesc răspuns?',
    answer: 'Răspundem în maxim 24 de ore, de obicei mult mai rapid în timpul programului de lucru.',
  },
  {
    question: 'Lucrați și cu afaceri din afara Sibiului?',
    answer: 'Da, lucrăm online cu antreprenori din toată țara. Biroul din Sibiu este opțional pentru întâlniri față în față.',
  },
  {
    question: 'Care e procesul după ce trimit mesajul?',
    answer: 'Te contactăm pentru a stabili o discuție scurtă, înțelegem nevoile tale, apoi îți propunem un plan concret de acțiune.',
  },
];

const googleMapsShareUrl = 'https://share.google/qSvcuPumA5VpGPHJ5';
const googleMapsQuery = address.fullAddress;
const googleMapsUrl = `https://www.google.com/maps?q=${encodeURIComponent(googleMapsQuery)}&hl=ro&z=18&output=embed`;
const googleMapsLink = googleMapsShareUrl;
const latitude = 45.7972;
const longitude = 24.1521;
const wazeLink = `https://waze.com/ul?q=${encodeURIComponent(googleMapsQuery)}&navigate=yes`;
const appleMapsLink = `https://maps.apple.com/?q=${encodeURIComponent(googleMapsQuery)}&ll=${latitude},${longitude}`;
---

<BaseLayout
  title="Contact - Mindleap"
  description="Contactează echipa Mindleap pentru o consultație gratuită despre serviciile noastre de marketing digital. Ne găsești în Sibiu, str. D. D. Roșca nr. 58."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section class="contact-hero relative w-full pt-20 pb-10 md:pt-32 md:pb-20 overflow-hidden text-white">
    <div class="contact-hero-glow pointer-events-none absolute top-[-60px] left-1/2 -translate-x-1/2 w-[360px] h-[200px] rounded-full" aria-hidden="true"></div>
    <div class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-center mb-4 md:mb-5 text-balance">
        Hai să vorbim
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl text-center text-white/80 mb-3 max-w-2xl mx-auto text-balance">
        Suntem aici să te ajutăm să-ți construiești un ecosistem de marketing eficient.
      </p>
      <p class="text-base md:text-lg text-center text-white/60 max-w-xl mx-auto">
        Contactează-ne pentru o consultație gratuită.
      </p>
    </div>
  </section>

  <!-- Contact main -->
  <section class="contact-main py-16 md:py-24 w-full text-white">
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 mb-16">

        <!-- Informații -->
        <div class="contact-card order-2 lg:order-1">
          <h2 class="text-2xl md:text-3xl font-bold mb-8 text-white">Informații de contact</h2>
          <div class="space-y-8">
            {SITE.phone && (
              <div>
                <p class="text-xs font-semibold text-white/50 mb-2 uppercase tracking-wider">Telefon</p>
                <div class="flex flex-col">
                  <a
                    href={`tel:${SITE.phone.replace(/\s/g, '')}`}
                    class="inline-flex items-center gap-2 text-xl md:text-2xl font-semibold text-white hover:text-primary-mint transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-mint focus:ring-offset-2 focus:ring-offset-[#0a0e1a] rounded-md group"
                  >
                    <i class="ti ti-phone text-primary-mint text-xl transition-transform duration-200 group-hover:scale-110" aria-hidden="true"></i>
                    {SITE.phone}
                  </a>
                  <span class="text-base text-white/50 mt-1">{contactName}</span>
                </div>
              </div>
            )}

            <div>
              <p class="text-xs font-semibold text-white/50 mb-2 uppercase tracking-wider">Email</p>
              <a
                href={`mailto:${contactEmail}`}
                class="inline-flex items-center gap-2 text-xl md:text-2xl font-semibold text-white hover:text-primary-mint transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-mint focus:ring-offset-2 focus:ring-offset-[#0a0e1a] rounded-md break-all group"
              >
                <i class="ti ti-mail text-primary-mint text-xl transition-transform duration-200 group-hover:scale-110" aria-hidden="true"></i>
                {contactEmail}
              </a>
            </div>

            <div>
              <p class="text-xs font-semibold text-white/50 mb-2 uppercase tracking-wider">Adresa</p>
              <address class="not-italic text-base md:text-lg text-white/80">
                <p class="font-medium text-white">{address.street}</p>
                <p>{address.city}, {address.county}</p>
                <p>{address.postalCode}</p>
                <p>{address.country}</p>
              </address>
            </div>

            <div class="pt-4 border-t border-white/10">
              <p class="text-xs font-semibold text-white/50 mb-3 uppercase tracking-wider">Program</p>
              <div class="space-y-1">
                <p class="text-base md:text-lg text-white/80">Luni - Vineri: <span class="font-medium text-white">09:00 - 18:00</span></p>
                <p class="text-base md:text-lg text-white/80">Sâmbătă - Duminică: <span class="font-medium text-white">Închis</span></p>
              </div>
            </div>

            <div class="pt-4 border-t border-white/10">
              <LiquidGlassButton href={whatsappLink} variant="glass-primary" target="_blank" rel="noopener noreferrer" class="w-full">
                <i class="ti ti-brand-whatsapp text-lg" aria-hidden="true"></i>
                Scrie-ne pe WhatsApp
              </LiquidGlassButton>
            </div>

            <div class="pt-4 border-t border-white/10">
              <p class="text-xs font-semibold text-white/50 mb-3 uppercase tracking-wider">Urmărește-ne</p>
              <div class="grid grid-cols-2 gap-3">
                {socialLinks.map((social) => (
                  <a
                    href={social.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="social-card"
                    aria-label={social.name}
                  >
                    <i class={`ti ${social.icon}`} aria-hidden="true"></i>
                    <span>{social.name}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- Formular -->
        <div class="contact-card order-1 lg:order-2">
          <h2 class="text-2xl md:text-3xl font-bold mb-3 text-white">Trimite un mesaj</h2>
          <p class="text-sm text-white/55 mb-7">Răspundem în maxim 24h, de obicei mult mai rapid.</p>
          <form class="space-y-5" method="POST" action="/api/contact">
            <div>
              <label for="name" class="block text-sm font-semibold text-white/70 mb-2">Nume complet *</label>
              <input type="text" id="name" name="name" required class="contact-input" aria-required="true" placeholder="Introdu numele tău" />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-white/70 mb-2">Email *</label>
              <input type="email" id="email" name="email" required class="contact-input" aria-required="true" placeholder="email@exemplu.ro" />
            </div>
            <div>
              <label for="phone" class="block text-sm font-semibold text-white/70 mb-2">Telefon</label>
              <input type="tel" id="phone" name="phone" class="contact-input" placeholder="+40 7XX XXX XXX" />
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-white/70 mb-2">Mesaj *</label>
              <textarea id="message" name="message" rows="5" required class="contact-input resize-none" aria-required="true" placeholder="Spune-ne despre proiectul tău..."></textarea>
            </div>
            <div id="form-feedback" class="hidden text-sm font-medium text-primary-mint" role="status" aria-live="polite"></div>
            <div class="pt-2">
              <LiquidGlassButton variant="glass-primary" type="submit" class="w-full">
                Trimite mesaj
              </LiquidGlassButton>
            </div>
          </form>
        </div>
      </div>

      <!-- Hartă -->
      <div class="mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-4 text-white">Unde ne găsești?</h2>
        <p class="text-center text-white/60 mb-10 max-w-2xl mx-auto">
          Ne găsești la biroul nostru din Sibiu sau ne poți contacta online.
        </p>
        <div class="contact-map-wrap">
          <div class="contact-map-card overflow-hidden">
            <iframe
              src={googleMapsUrl}
              width="100%"
              height="100%"
              class="contact-map-iframe"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title={`Locația ${address.placeName} - ${address.fullAddress}`}
              aria-label={`Hartă Google Maps cu locația ${address.placeName}`}
            ></iframe>
          </div>
          <div class="mt-6 flex flex-col sm:flex-row gap-3.5 justify-center items-center flex-wrap">
            <LiquidGlassButton href={googleMapsLink} target="_blank" rel="noopener noreferrer" variant="glass-primary">
              Google Maps
            </LiquidGlassButton>
            <LiquidGlassButton href={wazeLink} target="_blank" rel="noopener noreferrer" variant="glass-secondary">
              Waze
            </LiquidGlassButton>
            <LiquidGlassButton href={appleMapsLink} target="_blank" rel="noopener noreferrer" variant="glass-secondary">
              Apple Maps
            </LiquidGlassButton>
          </div>
        </div>
      </div>

      <!-- FAQ -->
      <div class="mb-16">
        <h2 class="text-2xl md:text-3xl font-bold text-center mb-8 text-white">Întrebări frecvente</h2>
        <div class="max-w-4xl mx-auto space-y-3">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">
                <span>{faq.question}</span>
                <i class="ti ti-chevron-down faq-chevron" aria-hidden="true"></i>
              </summary>
              <p class="faq-answer">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-hero,
  .contact-main {
    background: radial-gradient(circle at 50% 0%, #16332b 0%, #0a0e1a 60%);
  }

  .contact-hero-glow {
    background: rgba(64, 255, 170, 0.1);
    filter: blur(60px);
  }

  .contact-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    padding: 28px 26px;
  }

  .contact-map-wrap {
    width: 100%;
  }

  .contact-map-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    height: 400px;
  }

  @media (min-width: 768px) {
    .contact-map-card {
      height: 480px;
    }
  }

  .contact-map-iframe {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 400px;
    border-radius: 18px;
  }

  @media (min-width: 768px) {
    .contact-map-iframe {
      min-height: 480px;
    }
  }

  .contact-input {
    width: 100%;
    padding: 11px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 0.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    color: #f5f7fa;
    font-size: 14px;
    min-height: 48px;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .contact-input::placeholder {
    color: rgba(255, 255, 255, 0.35);
  }

  .contact-input:focus {
    outline: none;
    border-color: rgba(64, 255, 170, 0.5);
    background: rgba(255, 255, 255, 0.07);
  }

  .social-card {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.05);
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    color: #f5f7fa;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .social-card :global(.ti) {
    font-size: 17px;
    color: #40ffaa;
  }

  .social-card:hover {
    border-color: rgba(64, 255, 170, 0.4);
    background: rgba(255, 255, 255, 0.08);
  }

  .faq-item {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 4px 20px;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    font-size: 15px;
    font-weight: 600;
    color: #f5f7fa;
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-chevron {
    font-size: 18px;
    color: #40ffaa;
    flex-shrink: 0;
    margin-left: 12px;
    transition: transform 0.2s ease;
  }

  details[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-answer {
    font-size: 14px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    padding: 0 0 18px;
    margin: 0;
  }
</style>

<script>
  const form = document.querySelector('form[action="/api/contact"]');
  const feedback = document.getElementById('form-feedback');

  if (form && feedback) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) submitBtn.setAttribute('disabled', 'true');

      try {
        const formData = new FormData(form as HTMLFormElement);
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            phone: formData.get('phone'),
            message: formData.get('message'),
          }),
        });

        feedback.classList.remove('hidden');
        if (response.ok) {
          feedback.textContent = 'Mesaj trimis. Te contactăm în maxim 24h.';
          feedback.style.color = '#40ffaa';
          (form as HTMLFormElement).reset();
        } else {
          feedback.textContent = 'A apărut o eroare. Încearcă din nou sau scrie-ne pe WhatsApp.';
          feedback.style.color = '#f09595';
        }
      } catch {
        feedback.classList.remove('hidden');
        feedback.textContent = 'A apărut o eroare. Încearcă din nou sau scrie-ne pe WhatsApp.';
        feedback.style.color = '#f09595';
      } finally {
        if (submitBtn) submitBtn.removeAttribute('disabled');
      }
    });
  }
</script>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": address.placeName,
  "description": SITE.description,
  "url": siteUrl,
  "telephone": SITE.phone,
  "email": contactEmail,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": address.street,
    "addressLocality": address.city,
    "addressRegion": address.county,
    "postalCode": address.postalCode,
    "addressCountry": "RO"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 45.7972,
    "longitude": 24.1521
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "09:00",
      "closes": "18:00"
    }
  ],
  "areaServed": {
    "@type": "Country",
    "name": "Romania"
  },
  "sameAs": [
    SITE.social.facebook,
    SITE.social.instagram,
    SITE.social.linkedin,
    SITE.social.tiktok
  ]
})} />
