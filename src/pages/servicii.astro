---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
import LiquidGlassButton from '@/components/ui/LiquidGlassButton.astro';
import '@/styles/global.css';

const breadcrumbs = [
  { name: 'Acasă', href: '/' },
  { name: 'Servicii', href: '/servicii' },
];

type ProblemService = {
  id: string;
  problem: string;
  shortProblem: string;
  serviceName: string;
  serviceFor: string;
  intro: string[];
  what: string[];
  result: string;
  ctaLabel: string;
};

const problemServices: ProblemService[] = [
  {
    id: 'strategie-audit',
    problem: 'Fac multe, dar nu știu ce funcționează',
    shortProblem: 'Fac multe, dar nu știu ce funcționează',
    serviceName: 'Strategie și audit de marketing',
    serviceFor:
      'Pentru antreprenorii care simt că marketingul consumă timp, energie și bani, dar nu le oferă suficientă claritate.',
    intro: [
      'Poate postezi. Poate rulezi reclame. Poate ai website. Poate ai idei bune.',
      'Dar dacă nu știi ce merită păstrat, ce trebuie oprit și ce trebuie construit mai departe, ajungi să iei decizii la ghici.',
    ],
    what: [
      'Audit de ecosistem marketing',
      'Analiză website',
      'Analiză social media',
      'Analiză funnel',
      'Analiză mesaj și ofertă',
      'Roadmap de creștere',
    ],
    result: 'Claritate, priorități, direcție și un plan concret de acțiune.',
    ctaLabel: 'Vreau claritate',
  },
  {
    id: 'social-media',
    problem: 'Postez, dar nu se leagă nimic',
    shortProblem: 'Postez, dar nu se leagă nimic',
    serviceName: 'Social media management',
    serviceFor:
      'Pentru businessuri care vor o prezență coerentă în social media, nu doar postări puse în calendar ca să existe activitate.',
    intro: [
      'Problema nu e mereu că nu postezi suficient.',
      'Problema poate fi că postările nu construiesc o direcție. Nu susțin aceeași idee. Nu clarifică oferta. Nu duc omul mai aproape de decizie.',
    ],
    what: [
      'Strategie de conținut',
      'Calendar editorial',
      'Texte pentru postări',
      'Design pentru postări',
      'Publicare',
      'Optimizare lunară',
    ],
    result: 'O prezență mai clară, mai coerentă și mai relevantă pentru clientul potrivit.',
    ctaLabel: 'Vreau social media',
  },
  {
    id: 'reels-video',
    problem: 'Reelsurile atrag atenție, dar nu aduc oameni potriviți',
    shortProblem: 'Reelsurile nu aduc oameni potriviți',
    serviceName: 'Reels și short form video',
    serviceFor:
      'Pentru branduri care vor să folosească video scurt ca instrument de claritate, nu doar ca format care arată bine în feed.',
    intro: [
      'Un reel bun nu e doar un video care se mișcă repede.',
      'Trebuie să oprească scroll-ul. Să atingă o problemă reală. Să fie ușor de înțeles. Să ducă omul spre o idee clară despre brandul tău.',
    ],
    what: [
      'Idei de reels',
      'Hook-uri',
      'Scripturi',
      'Structură narativă',
      'Direcție de filmare',
      'Editare video',
      'Texte pentru descriere',
      'Adaptare pentru Instagram, Facebook, TikTok sau YouTube Shorts',
    ],
    result:
      'Conținut video mai clar, mai relevant și mai orientat spre oamenii pe care chiar vrei să îi atragi.',
    ctaLabel: 'Vreau reels',
  },
  {
    id: 'advertising',
    problem: 'Ads-urile consumă buget, dar nu îți dau claritate',
    shortProblem: 'Ads-urile consumă buget fără claritate',
    serviceName: 'Advertising și performance marketing',
    serviceFor:
      'Pentru businessuri care vor să folosească bugetul de promovare mai inteligent, cu mesaje, campanii și decizii bazate pe date.',
    intro: [
      'Reclamele nu repară un mesaj slab. Nu salvează o ofertă neclară. Nu transformă automat traficul în cereri.',
      'Ads-urile funcționează mai bine când amplifică un sistem clar.',
    ],
    what: [
      'Strategie de campanii',
      'Meta Ads',
      'Google Ads',
      'Setare campanii',
      'Tracking',
      'Testare creativă',
      'Optimizare',
      'Raportare',
    ],
    result: 'Campanii mai clare, bugete mai bine folosite și decizii luate pe date, nu pe impresii.',
    ctaLabel: 'Vreau reclame',
  },
  {
    id: 'copywriting-funnel',
    problem: 'Oamenii nu înțeleg suficient de repede de ce să aleagă',
    shortProblem: 'Oamenii nu înțeleg de ce să aleagă',
    serviceName: 'Copywriting și funnel',
    serviceFor:
      'Pentru businessuri care au o ofertă bună, dar mesajul nu o face suficient de clară, relevantă sau convingătoare.',
    intro: [
      'Clientul nu are timp să descifreze ce vinzi.',
      'Dacă mesajul e prea general, prea tehnic sau prea centrat pe tine, omul trece mai departe. Un text bun trebuie să răspundă rapid la întrebarea: de ce ar trebui să îmi pese?',
    ],
    what: [
      'Copy pentru website',
      'Landing pages',
      'Texte pentru reclame',
      'Texte pentru emailuri',
      'Structură de funnel',
      'Mesaje de vânzare',
      'CTA-uri',
      'Secvențe de follow-up',
    ],
    result: 'Un mesaj mai clar, o ofertă mai ușor de înțeles și un traseu mai logic de la interes la acțiune.',
    ctaLabel: 'Vreau un mesaj mai convingător',
  },
  {
    id: 'design-creative',
    problem: 'Brandul nu arată la nivelul ofertei tale',
    shortProblem: 'Brandul nu arată la nivelul ofertei',
    serviceName: 'Design grafic și creative direction',
    serviceFor: 'Pentru businessuri care vor să arate mai coerent, mai profesionist și mai ușor de recunoscut.',
    intro: [
      'Designul nu e doar decor.',
      'E primul semnal de încredere. E felul în care oamenii simt dacă brandul tău e serios, coerent și relevant pentru ei. Dacă vizualurile sunt inconsistente, mesajul pierde forță.',
    ],
    what: [
      'Design social media',
      'Bannere',
      'Materiale promoționale',
      'Vizualuri pentru campanii',
      'Direcție vizuală',
      'Adaptări pentru digital și print',
    ],
    result: 'Un brand mai coerent, mai recognoscibil și mai credibil în toate punctele de contact.',
    ctaLabel: 'Vreau un brand mai coerent',
  },
];

const howWeWork = [
  {
    step: '01',
    title: 'Scanăm',
    description: 'Vedem unde ești acum, ce ai deja construit și unde se pierde atenția, încrederea sau cererea.',
  },
  {
    step: '02',
    title: 'Prioritizăm',
    description: 'Nu îți recomandăm tot. Alegem piesele care au cel mai mult sens pentru etapa în care e businessul tău.',
  },
  {
    step: '03',
    title: 'Construim',
    description: 'Punem în mișcare strategia, conținutul, campaniile, textele, materialele vizuale sau funnel-ul de care ai nevoie.',
  },
  {
    step: '04',
    title: 'Optimizăm',
    description: 'Măsurăm, ajustăm și îmbunătățim sistemul pe termen lung.',
  },
];
---

<BaseLayout
  title="Servicii - Mindleap"
  description="Nu ai nevoie de mai mult marketing. Ai nevoie de claritate. Descoperă serviciile Mindleap organizate după problema reală cu care te confrunți."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section class="servicii-section servicii-hero relative w-full py-20 md:py-32 overflow-hidden text-white">
    <div class="servicii-hero-glow pointer-events-none absolute top-[-100px] left-1/2 -translate-x-1/2 w-[600px] h-[300px] rounded-full" aria-hidden="true"></div>

    <div class="relative w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="font-bold mb-6 text-balance leading-tight">
        <span class="block text-2xl md:text-3xl lg:text-4xl text-white/90 font-semibold mb-2 md:mb-3">
          Nu ai nevoie de mai mult marketing.
        </span>
        <span class="block text-4xl md:text-5xl lg:text-6xl text-primary-mint">
          Ai nevoie de claritate.
        </span>
      </h1>
      <p class="text-base md:text-lg text-white/65 max-w-2xl mx-auto text-balance mb-10 leading-relaxed">
        Construim strategie, conținut, reclame, funnel-uri și materiale vizuale pentru antreprenorii care vor să transforme atenția în leaduri.
      </p>

      <div class="flex flex-col sm:flex-row gap-3.5 justify-center items-center flex-wrap">
        <LiquidGlassButton href="#probleme" variant="glass-primary">
          Alege ce vrei să repari
        </LiquidGlassButton>
        <LiquidGlassButton href="#toate-serviciile" variant="glass-secondary">
          Vezi toate serviciile
        </LiquidGlassButton>
      </div>
    </div>
  </section>

  <!-- Problem selector -->
  <section id="probleme" class="servicii-section py-16 md:py-20 w-full text-white scroll-mt-24">
    <div class="w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 md:mb-12">
        <h2 class="text-2xl md:text-3xl font-bold mb-3 text-white">
          Unde simți că se rupe marketingul tău?
        </h2>
        <p class="text-sm md:text-base text-white/55">
          Alege problema care descrie cel mai bine situația ta și vezi ce serviciu se potrivește.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {problemServices.map((item) => (
          <a href={`#${item.id}`} class="problem-pill">
            <span class="problem-pill-text">{item.shortProblem}</span>
            <span class="problem-pill-service">
              {item.serviceName}
              <i class="ti ti-arrow-right" aria-hidden="true"></i>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Detailed services -->
  <section id="toate-serviciile" class="servicii-section py-16 md:py-24 w-full text-white scroll-mt-24">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20 md:space-y-28">
      {problemServices.map((item, i) => (
        <div id={item.id} class="scroll-mt-24">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-start">
            <div>
              <span class="service-detail-index">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="text-2xl md:text-3xl font-bold text-white mt-3 mb-2">{item.problem}</h3>
              <p class="text-base font-semibold text-primary-mint mb-5">{item.serviceName}</p>
              <p class="text-sm md:text-base text-white/55 mb-6 leading-relaxed">{item.serviceFor}</p>
              {item.intro.map((paragraph) => (
                <p class="text-sm md:text-base text-white/70 mb-4 leading-relaxed">{paragraph}</p>
              ))}
            </div>

            <div class="servicii-card">
              <p class="text-xs font-semibold text-white/45 mb-4 uppercase tracking-wider">Ce construim</p>
              <div class="flex flex-wrap gap-2 mb-7">
                {item.what.map((w) => (
                  <span class="what-pill">{w}</span>
                ))}
              </div>

              <p class="text-xs font-semibold text-white/45 mb-2 uppercase tracking-wider">Rezultatul urmărit</p>
              <p class="text-sm md:text-base text-white/75 mb-7 leading-relaxed">{item.result}</p>

              <LiquidGlassButton href="/contact" variant="glass-primary" class="w-full">
                {item.ctaLabel}
              </LiquidGlassButton>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Ecosystem -->
  <section class="servicii-section py-16 md:py-24 w-full text-white">
    <div class="w-full max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-6 text-white text-balance">
        Serviciile pot fi alese separat.<br />Dar cele mai bune rezultate apar când lucrează împreună.
      </h2>

      <div class="servicii-card text-left mb-8">
        <p class="text-sm md:text-base text-white/75 mb-2 leading-relaxed">Strategia îți arată ce merită făcut.</p>
        <p class="text-sm md:text-base text-white/75 mb-2 leading-relaxed">Copywritingul clarifică mesajul.</p>
        <p class="text-sm md:text-base text-white/75 mb-2 leading-relaxed">Designul construiește încredere.</p>
        <p class="text-sm md:text-base text-white/75 mb-2 leading-relaxed">Conținutul atrage atenția potrivită.</p>
        <p class="text-sm md:text-base text-white/75 mb-2 leading-relaxed">Reclamele duc mesajul către mai mulți oameni.</p>
        <p class="text-sm md:text-base text-white/75 leading-relaxed">Funnel-ul transformă interesul în acțiune.</p>
      </div>

      <p class="text-base md:text-lg text-primary-mint font-semibold">
        Asta numim noi ecosistem de marketing și vânzări.
      </p>
    </div>
  </section>

  <!-- How we work -->
  <section class="servicii-section py-16 md:py-24 w-full text-white">
    <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-12 text-center text-white">
        Cum lucrăm
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {howWeWork.map((item) => (
          <div class="how-we-work-card">
            <span class="how-we-work-step">{item.step}</span>
            <h3 class="text-base font-semibold text-white mb-2 mt-3">{item.title}</h3>
            <p class="text-sm text-white/60 leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Not sure -->
  <section class="servicii-section py-16 md:py-20 w-full text-white">
    <div class="w-full max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-bold mb-4 text-white">
        Nu știi exact ce serviciu îți trebuie?
      </h2>
      <p class="text-sm md:text-base text-white/55 mb-6">E normal.</p>

      <div class="servicii-card text-left mb-8">
        <p class="text-sm md:text-base text-white/70 mb-2 leading-relaxed">Mulți antreprenori cer social media, dar problema reală e mesajul.</p>
        <p class="text-sm md:text-base text-white/70 mb-2 leading-relaxed">Cer reclame, dar pagina nu convinge.</p>
        <p class="text-sm md:text-base text-white/70 mb-2 leading-relaxed">Cer reels, dar nu există o direcție clară.</p>
        <p class="text-sm md:text-base text-white/70 leading-relaxed">Cer design, dar oferta nu e suficient de bine explicată.</p>
      </div>

      <p class="text-sm md:text-base text-white/70">
        De aceea începem prin a înțelege unde se rupe sistemul. Apoi îți recomandăm serviciul potrivit.
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="servicii-section servicii-cta py-20 md:py-28 w-full text-white">
    <div class="w-full max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl md:text-4xl font-bold mb-6 text-white text-balance">
        Vrei să vezi ce piesă lipsește din marketingul tău?
      </h2>
      <p class="text-sm md:text-base text-white/60 mb-10">
        Programează o discuție cu MindLeap și identificăm împreună ce are cel mai mult sens pentru businessul tău.
      </p>
      <LiquidGlassButton href="/contact" variant="glass-primary">
        Vreau să aflu ce mi se potrivește
      </LiquidGlassButton>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": problemServices.map((item, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "item": {
        "@type": "Service",
        "name": item.serviceName,
        "description": item.serviceFor,
        "provider": {
          "@type": "Organization",
          "name": SITE.name,
          "url": SITE.url
        },
        "areaServed": {
          "@type": "Country",
          "name": "Romania"
        }
      }
    }))
  })} />
</BaseLayout>

<style>
  .servicii-section {
    background: radial-gradient(circle at 50% 0%, #16332b 0%, #0a0e1a 60%);
  }

  .servicii-cta {
    background: radial-gradient(circle at 50% 100%, #16332b 0%, #0a0e1a 60%);
  }

  .servicii-hero-glow {
    background: rgba(64, 255, 170, 0.12);
    filter: blur(60px);
  }

  .servicii-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 18px;
    padding: 28px 26px;
  }

  .problem-pill {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px;
    border-radius: 14px;
    text-decoration: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.15s ease;
  }

  .problem-pill:hover {
    border-color: rgba(64, 255, 170, 0.5);
    background: linear-gradient(135deg, rgba(64, 255, 170, 0.12), rgba(255, 255, 255, 0.03));
    transform: translateY(-2px);
  }

  .problem-pill-text {
    font-size: 14px;
    font-weight: 600;
    color: #f5f7fa;
    line-height: 1.4;
  }

  .problem-pill-service {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 600;
    color: #40ffaa;
  }

  .problem-pill-service :global(.ti) {
    font-size: 13px;
  }

  .service-detail-index {
    font-size: 13px;
    font-weight: 700;
    color: #40ffaa;
    letter-spacing: 0.05em;
  }

  .what-pill {
    font-size: 12.5px;
    font-weight: 500;
    color: #c5cedc;
    background: rgba(255, 255, 255, 0.05);
    border: 0.5px solid rgba(255, 255, 255, 0.1);
    padding: 7px 13px;
    border-radius: 8px;
  }

  .how-we-work-card {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 0.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 22px 20px;
  }

  .how-we-work-step {
    font-size: 22px;
    font-weight: 700;
    color: #40ffaa;
  }
</style>
