---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LiquidGlassButton from '@/components/ui/LiquidGlassButton.astro';
import ValuesCarousel from '@/components/ui/ValuesCarousel';
import TeamSection from '@/components/ui/TeamSection';
import '@/styles/global.css';

// ─────────────────────────────────────────────────────────────
// TEAM DATA — edit here to add/remove/reorder team members
// ─────────────────────────────────────────────────────────────

const founders = [
  {
    name: 'Ioan',
    role: 'Growth consultant • Co-fondator',
    photo: '/echipa/ioan.webp',
    icon: 'ti-rocket',
    description: '',
  },
  {
    name: 'Rebecca',
    role: 'Copywriting și strategie • Co-fondator',
    photo: '/echipa/rebecca.webp',
    icon: 'ti-pencil',
    description: '',
  },
];

const teamMembers = [
  { name: 'Vlăduț', role: 'Content creator', icon: 'ti-video', photo: '/echipa/vladut.webp' },
  { name: 'David', role: 'Ads', icon: 'ti-ad-2', photo: '/echipa/david.webp' },
  { name: 'Darius', role: 'Web development', icon: 'ti-code', photo: '/echipa/darius.webp' },
  { name: 'Bianca', role: 'Graphic design', icon: 'ti-palette', photo: '/echipa/bianca.webp' },
];

// ─────────────────────────────────────────────────────────────

const breadcrumbs = [
  { name: 'Acasă', href: '/' },
  { name: 'Despre noi', href: '/despre-noi' },
];
---

<BaseLayout
  title="Despre noi - Mindleap"
  description="Mindleap este o agenție de marketing digital dedicată ajutării business-urilor din România să-și atingă obiectivele prin strategii digitale eficiente și rezultate măsurabile."
  breadcrumbs={breadcrumbs}
>
  <!-- Hero -->
  <section class="relative w-full pt-20 pb-10 md:pt-32 md:pb-20 text-white overflow-hidden" style="background: radial-gradient(circle at 50% 0%, #16332B 0%, #0A0E1A 60%);">
    <div class="pointer-events-none absolute top-[-60px] left-1/2 -translate-x-1/2 w-[360px] h-[200px] rounded-full" style="background: rgba(64,255,170,0.12); filter: blur(60px);"></div>
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.1) 1px, transparent 1px); background-size: 50px 50px;"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold mb-4 md:mb-5 text-balance leading-tight">
        Despre Mindleap
      </h1>
      <p class="text-lg sm:text-xl md:text-2xl text-white/80 max-w-2xl mx-auto text-balance leading-relaxed">
        Transformăm ideile în rezultate digitale prin strategii inovatoare și execuție impecabilă
      </p>
    </div>
  </section>

  <!-- Misiune -->
  <section class="relative py-16 md:py-24 w-full text-white overflow-hidden" style="background: radial-gradient(circle at 30% 50%, #16332B 0%, #0A0E1A 60%);">
    <div class="pointer-events-none absolute top-0 left-0 w-full md:w-1/2 h-full" style="background: radial-gradient(circle at 30% 40%, rgba(64,255,170,0.10), transparent 50%);"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6 md:mb-8 text-white leading-tight text-fade-in-up delay-2 mission-title">
          Ce ne propunem?
        </h2>
        <div class="space-y-4 sm:space-y-6 text-base sm:text-lg text-white/75 leading-relaxed">
          <p class="word-reveal-text mission-paragraph">
            <span class="mint-highlight">Misiunea noastră</span> este să educăm și să sprijinim antreprenorii în construirea unor ecosisteme de marketing eficiente, bazate pe o înțelegere reală a pieței și a comportamentului consumatorilor, astfel încât afacerile lor să poată genera profit sănătos și creștere sustenabilă.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Viziune -->
  <section class="relative py-16 md:py-24 w-full text-white overflow-hidden" style="background: radial-gradient(circle at 70% 50%, #16332B 0%, #0A0E1A 60%);">
    <div class="pointer-events-none absolute top-0 right-0 w-full md:w-1/2 h-full" style="background: radial-gradient(circle at 70% 30%, rgba(64,255,170,0.08), transparent 55%);"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-6 md:mb-8 text-white leading-tight text-fade-in-up delay-2 vision-title">
          Unde ne îndreptăm?
        </h2>
        <div class="space-y-4 sm:space-y-6 text-base sm:text-lg text-white/75 leading-relaxed">
          <p class="word-reveal-text vision-paragraph">
            <span class="mint-highlight">Viziunea noastră</span> este să contribuim la crearea unui context economic armonios, în care marketingul nu distorsionează deciziile, ci le clarifică, conectând corect afacerile cu oamenii care au nevoie reală de produsele și serviciile lor.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Valori -->
  <section class="relative py-16 md:py-24 text-white w-full overflow-hidden" style="background: radial-gradient(circle at 50% 50%, #16332B 0%, #0A0E1A 60%);">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(circle at 50% 50%, rgba(64,255,170,0.08), transparent 70%);"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto mb-8 md:mb-10 text-center">
        <div class="mb-4">
          <span class="text-xs sm:text-sm font-semibold text-white/60 uppercase tracking-wider">
            Valorile noastre
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 md:mb-6 text-white leading-tight">
          Ce ne ghidează?
        </h2>
        <p class="text-base sm:text-lg md:text-xl text-white/70 leading-relaxed">
          Valorile care stau la baza tuturor deciziilor și acțiunilor noastre
        </p>
      </div>

      <div class="max-w-5xl mx-auto">
        <ValuesCarousel
          client:load
          autoPlay={true}
          interval={5000}
          values={[
            {
              title: 'Autenticitate',
              description: 'Facem lucrurile în stilul nostru, chiar și atunci când abordările sunt mai creative sau mai puțin convenționale. Nu urmăm rețete doar pentru că „așa se face", ci construim soluții care ne reprezintă și care au sens pentru fiecare business în parte.',
              spotlightColor: 'rgba(64, 255, 170, 0.2)',
              icon: 'ti-fingerprint',
            },
            {
              title: 'Responsabilitate',
              description: 'Suntem conștienți că fiecare decizie are impact. Ne asumăm rolurile, deciziile și consecințele, rămânem consecvenți și rezilienți și muncim constant pentru a atinge obiectivele stabilite, chiar și atunci când drumul nu este simplu.',
              spotlightColor: 'rgba(64, 255, 170, 0.2)',
              icon: 'ti-shield-check',
            },
            {
              title: 'Transparență',
              description: 'Credem în claritate, onestitate și comunicare corectă. Explicăm ce facem, de ce facem și ce rezultate pot fi așteptate, fără jargon inutil sau promisiuni nerealiste.',
              spotlightColor: 'rgba(64, 255, 170, 0.2)',
              icon: 'ti-eye',
            },
            {
              title: 'Colaborare',
              description: 'Îi considerăm pe clienții noștri parteneri, nu simple „pusculițe". Construim relații bazate pe încredere, implicare reală și obiective comune, lucrând împreună pentru rezultate pe termen lung.',
              spotlightColor: 'rgba(64, 255, 170, 0.2)',
              icon: 'ti-puzzle',
            },
            {
              title: 'Performanță',
              description: 'Știm că vorbele frumoase pot convinge, dar performanța se măsoară în rezultate. Suntem orientați spre implementarea corectă a proceselor, monitorizarea atentă a KPI-urilor și luarea deciziilor pe baza datelor, pentru a obține impact real și benefic în business.',
              spotlightColor: 'rgba(64, 255, 170, 0.2)',
              icon: 'ti-trending-up',
            },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- Echipa -->
  <section class="relative py-16 md:py-24 w-full text-white overflow-hidden" style="background: radial-gradient(circle at 50% 0%, #16332B 0%, #0A0E1A 60%);">
    <div class="pointer-events-none absolute top-[-80px] left-1/2 -translate-x-1/2 w-[500px] h-[240px] rounded-full" style="background: rgba(64,255,170,0.10); filter: blur(60px);"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto mb-12 md:mb-16 text-center">
        <div class="mb-4">
          <span class="text-xs sm:text-sm font-semibold text-white/50 uppercase tracking-wider">
            Echipa
          </span>
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 md:mb-6 text-white leading-tight">
          Oamenii din spatele sistemului
        </h2>
      </div>

      <!-- Fondatori -->
      <div class="max-w-4xl mx-auto mb-10 md:mb-12">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {founders.map((founder) => (
            <div class="glass-card-dark p-5 md:p-6 flex gap-4 items-center">
              <div class="w-16 h-16 md:w-20 md:h-20 rounded-2xl flex-shrink-0 relative overflow-hidden founder-avatar">
                <img
                  src={founder.photo}
                  alt={`${founder.name}, ${founder.role}`}
                  class="w-full h-full object-cover absolute inset-0"
                  width="80"
                  height="80"
                  loading="lazy"
                  onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
                />
                <div class="w-full h-full items-center justify-center" style="display: none;">
                  <i class={`ti ${founder.icon}`} style="font-size: 28px; color: #40ffaa;" aria-hidden="true"></i>
                </div>
              </div>
              <div>
                <h3 class="text-lg md:text-xl font-semibold text-white mb-1">{founder.name}</h3>
                <p class="text-primary-mint text-sm font-medium mb-2">{founder.role}</p>
                <p class="text-sm text-white/65 leading-relaxed">{founder.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Restul echipei -->
      <div class="max-w-5xl mx-auto">
        <TeamSection client:load members={teamMembers} />
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative py-16 md:py-24 text-white w-full overflow-hidden" style="background: radial-gradient(circle at 50% 100%, #16332B 0%, #0A0E1A 60%);">
    <div class="pointer-events-none absolute inset-0" style="background: radial-gradient(circle at 50% 50%, rgba(64,255,170,0.08), transparent 70%);"></div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold mb-4 md:mb-6 text-balance">
        Hai să lucrăm împreună
      </h2>
      <p class="text-base sm:text-lg md:text-xl text-white/70 mb-8 md:mb-10 max-w-2xl mx-auto text-balance">
        Suntem aici să transformăm ideile tale în rezultate digitale concrete
      </p>
      <div class="flex flex-col sm:flex-row gap-3.5 justify-center items-center flex-wrap">
        <LiquidGlassButton href="/contact" variant="glass-primary">
          Contactează-ne
        </LiquidGlassButton>
        <LiquidGlassButton href="/servicii" variant="glass-secondary">
          Vezi serviciile
        </LiquidGlassButton>
      </div>
    </div>
  </section>

  <style>
    @keyframes fade-in-up {
      from {
        opacity: 0;
        transform: translate3d(0, 30px, 0);
      }
      to {
        opacity: 1;
        transform: translate3d(0, 0, 0);
      }
    }

    .text-fade-in-up {
      opacity: 0;
      will-change: transform, opacity;
    }

    .text-fade-in-up.visible {
      animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .text-fade-in-up.delay-2.visible {
      animation: fade-in-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
    }

    .mission-title,
    .vision-title {
      position: relative;
      display: inline-block;
    }

    .mission-title::after,
    .vision-title::after {
      content: '';
      position: absolute;
      bottom: -8px;
      left: 0;
      width: 100%;
      height: 3px;
      background: linear-gradient(90deg, rgba(64, 255, 170, 0.7), transparent);
      border-radius: 2px;
      animation: underline-grow-full 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
      opacity: 0;
    }

    .mission-title.visible::after,
    .vision-title.visible::after {
      opacity: 1;
    }

    @keyframes underline-grow-full {
      from {
        width: 0;
        opacity: 0;
      }
      to {
        width: 100%;
        opacity: 1;
      }
    }

    .mint-highlight {
      position: relative;
      display: inline-block;
      font-weight: 700;
      color: #40ffaa;
      padding: 0 0.1em;
    }

    .mint-highlight::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.05em;
      height: 0.5em;
      background: linear-gradient(180deg, rgba(64, 255, 170, 0.22), rgba(64, 255, 170, 0.06));
      border-radius: 4px;
      z-index: -1;
      opacity: 0;
      transform: scaleX(0.95);
      transform-origin: left;
    }

    .word-reveal-text.visible .mint-highlight::after {
      animation: highlight-glow-appear 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.35s forwards;
    }

    @keyframes highlight-glow-appear {
      from {
        opacity: 0;
        transform: scaleX(0.9);
      }
      to {
        opacity: 1;
        transform: scaleX(1);
      }
    }

    .word-reveal-text {
      color: #f5f7fa;
      line-height: 1.85;
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 1.2s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .word-reveal-text.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .glass-card-dark {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.02));
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 0.5px solid rgba(255, 255, 255, 0.14);
      border-radius: 18px;
    }

    .founder-avatar {
      background: linear-gradient(135deg, rgba(64, 255, 170, 0.18), rgba(255, 255, 255, 0.04));
      border: 0.5px solid rgba(64, 255, 170, 0.4);
    }

    @media (prefers-reduced-motion: reduce) {
      .text-fade-in-up {
        opacity: 1;
        animation: none;
      }

      .word-reveal-text {
        opacity: 1;
        transform: none;
      }

      .mint-highlight::after {
        opacity: 1;
        transform: scaleX(1);
        animation: none;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const textElements = document.querySelectorAll('.text-fade-in-up');

      if (textElements.length > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        }, { root: null, rootMargin: '0px 0px -100px 0px', threshold: 0.1 });

        textElements.forEach((el) => observer.observe(el));
      } else if (textElements.length > 0) {
        textElements.forEach((el) => el.classList.add('visible'));
      }

      const wordTexts = document.querySelectorAll('.word-reveal-text');

      if (wordTexts.length > 0 && 'IntersectionObserver' in window) {
        const wordObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              wordObserver.unobserve(entry.target);
            }
          });
        }, { root: null, rootMargin: '0px 0px -100px 0px', threshold: 0.1 });

        wordTexts.forEach((el) => wordObserver.observe(el));
      } else if (wordTexts.length > 0) {
        wordTexts.forEach((el) => el.classList.add('visible'));
      }
    });
  </script>
</BaseLayout>
