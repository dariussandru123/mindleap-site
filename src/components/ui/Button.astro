---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  class?: string;
}

const { href, variant = 'primary', class: className = '' } = Astro.props;

const baseClasses = 'px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-offset-2 min-h-[40px] flex items-center justify-center';
const variants = {
  primary: 'bg-black text-white hover:bg-black/90 focus:ring-black',
  secondary: 'bg-white text-black hover:bg-white/90 focus:ring-white',
  outline: 'bg-transparent border-2 border-black text-black hover:bg-black/10 focus:ring-black',
};
---

{href ? (
  <a href={href} class={`${baseClasses} ${variants[variant]} ${className}`}>
    <slot />
  </a>
) : (
  <button class={`${baseClasses} ${variants[variant]} ${className}`}>
    <slot />
  </button>
)}

