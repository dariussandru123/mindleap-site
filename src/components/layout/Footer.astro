---
import { NAVIGATION, SITE } from '@/config/site';
import { getCurrentYear } from '@/lib/utils';
---

<footer class="bg-black text-white w-full" role="contentinfo">
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-16">
    <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-12 items-start">
      <!-- Logo and Company Info Column -->
      <div class="col-span-2 md:col-span-1 text-center md:text-left">
        <a
          href="/"
          class="inline-block mb-4 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-black rounded-md"
          aria-label="Mindleap - Pagina principală"
        >
          <img
            src="/mindleap-logo-banner.svg"
            alt="Mindleap Logo"
            class="h-8 md:h-10 w-auto brightness-0 invert"
            width="200"
            height="40"
            loading="lazy"
          />
        </a>
        <p class="text-white/80 text-sm mb-4">
          {SITE.description}
        </p>
        <!-- Social Media Links -->
        <div class="flex items-center justify-center md:justify-start gap-3">
          {SITE.social?.instagram && (
            <a
              href={SITE.social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
              aria-label="Instagram"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
          )}
          {SITE.social?.facebook && (
            <a
              href={SITE.social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
              aria-label="Facebook"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          )}
          {SITE.social?.linkedin && (
            <a
              href={SITE.social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
              aria-label="LinkedIn"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </a>
          )}
          {SITE.social?.tiktok && (
            <a
              href={SITE.social.tiktok}
              target="_blank"
              rel="noopener noreferrer"
              class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
              aria-label="TikTok"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
              </svg>
            </a>
          )}
        </div>
      </div>

      <!-- Navigation Column -->
      <div class="text-left">
        <h2 class="text-lg font-semibold mb-4">Navigare</h2>
        <nav aria-label="Navigare footer">
          <ul class="space-y-2">
            {NAVIGATION.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
                >
                  {item.name}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Contact Column -->
      <div class="text-left">
        <h2 class="text-lg font-semibold mb-4">Contact</h2>
        <address class="not-italic space-y-2 text-white/80">
          {SITE.phone && (
            <p>
              <a
                href={`tel:${SITE.phone.replace(/\s/g, '')}`}
                class="hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
              >
                {SITE.phone}
              </a>
            </p>
          )}
          <p>
            <a
              href="mailto:hello@mindleap.ro"
              class="hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
            >
              hello@mindleap.ro
            </a>
          </p>
          <p>
            <a
              href={`https://maps.google.com/?q=${encodeURIComponent(`${SITE.address.street}, ${SITE.address.city} ${SITE.address.postalCode}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
            >
              {SITE.address.street}<br />
              {SITE.address.city} {SITE.address.postalCode}
            </a>
          </p>
          <p class="text-sm text-white/70 pt-1">
            {SITE.company.legalName}<br />
            CUI: {SITE.company.cui}<br />
            {SITE.company.tradeRegister}
          </p>
        </address>
      </div>

      <!-- Legal Column -->
      <div class="text-left">
        <h2 class="text-lg font-semibold mb-4">Legal</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="/legal/termeni-si-conditii"
              class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
            >
              Termeni și condiții
            </a>
          </li>
          <li>
            <a
              href="/legal/politica-confidentialitate"
              class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
            >
              Politică de confidențialitate
            </a>
          </li>
          <li>
            <a
              href="/legal/cookies"
              class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
            >
              Cookies
            </a>
          </li>
          <li>
            <a
              href="/legal/personalizeaza-cookie-uri"
              class="text-white/80 hover:text-[#40ffaa] transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#40ffaa] focus:ring-offset-2 focus:ring-offset-black rounded-md"
            >
              Setări cookie-uri
            </a>
          </li>
        </ul>
        <div class="mt-6 flex flex-row items-center justify-start gap-4">
          <img
            src="/anpc-sal.webp"
            alt="ANPC SAL"
            class="h-8 w-auto opacity-80 hover:opacity-100 transition-opacity"
            width="80"
            height="32"
            loading="lazy"
          />
          <img
            src="/anpc-sol.webp"
            alt="ANPC SOL"
            class="h-8 w-auto opacity-80 hover:opacity-100 transition-opacity"
            width="80"
            height="32"
            loading="lazy"
          />
        </div>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-white/20 text-center text-white/60 text-sm">
      <p class="block md:inline">
        &copy; {getCurrentYear()} {SITE.name}. Toate drepturile rezervate.
      </p>
      <p class="block md:inline md:ml-1 mt-1 md:mt-0">
        Made with <span class="text-red-500">❤️</span> in Sibiu
      </p>
    </div>
  </div>
</footer>

<style>
  /* Ensure footer logo is white/inverted */
  footer img[alt="Mindleap Logo"] {
    filter: brightness(0) invert(1);
  }
</style>


