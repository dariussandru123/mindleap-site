---
import LiquidGlassButton from '@/components/ui/LiquidGlassButton.astro';
---

<section class="cta-section" aria-label="Contact">
  <div class="cta-section-inner">
    <div class="cta-section-card">
      <div class="glow glow-top" aria-hidden="true"></div>
      <div class="glow glow-bottom" aria-hidden="true"></div>

      <div class="cta-content">
        <h2 class="cta-title">Gata să-ți crești business-ul?</h2>
        <p class="cta-desc">
          Contactează-ne astăzi pentru o consultație gratuită și descoperă cum putem ajuta business-ul tău să crească.
        </p>
        <div class="cta-actions">
          <LiquidGlassButton href="/contact" variant="glass-primary">
            Contactează-ne
          </LiquidGlassButton>
          <LiquidGlassButton
            href={`https://wa.me/${import.meta.env.PUBLIC_WHATSAPP || '40756545054'}`}
            variant="glass-secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp
            <svg class="btn-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.881 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </LiquidGlassButton>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 4rem 0;
    background: #000;
    width: 100%;
    overflow: hidden;
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  @media (min-width: 768px) {
    .cta-section {
      padding: 6rem 0;
    }
  }

  .cta-section-inner {
    width: 100%;
    max-width: 80rem;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .cta-section-inner {
      padding: 0 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .cta-section-inner {
      padding: 0 2rem;
    }
  }

  .cta-section-card {
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 30% 0%, #16332b 0%, #0a0e1a 55%);
    border-radius: 20px;
    padding: 3rem 1.5rem;
    font-family: Inter, system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  @media (min-width: 1024px) {
    .cta-section-card {
      background: radial-gradient(circle at 25% 0%, #16332b 0%, #0a0e1a 55%);
      border-radius: 24px;
      padding: 3.5rem 3rem;
    }
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .glow-top {
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    background: rgba(64, 255, 170, 0.16);
    filter: blur(44px);
  }

  .glow-bottom {
    bottom: -80px;
    left: -60px;
    width: 200px;
    height: 200px;
    background: rgba(64, 255, 170, 0.08);
    filter: blur(44px);
  }

  @media (min-width: 1024px) {
    .glow-top {
      top: -100px;
      right: -80px;
      width: 340px;
      height: 340px;
      background: rgba(64, 255, 170, 0.14);
      filter: blur(60px);
    }

    .glow-bottom {
      bottom: -120px;
      left: -100px;
      width: 300px;
      height: 300px;
      background: rgba(64, 255, 170, 0.07);
      filter: blur(60px);
    }
  }

  .cta-content {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 42rem;
    margin: 0 auto;
  }

  .cta-title {
    font-size: 1.875rem;
    font-weight: 700;
    color: #f5f7fa;
    margin: 0 0 1rem;
    line-height: 1.2;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .cta-title {
      font-size: 2.25rem;
      margin-bottom: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .cta-title {
      font-size: 3rem;
    }
  }

  .cta-desc {
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(245, 247, 250, 0.8);
    margin: 0 auto 2rem;
    max-width: 32rem;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .cta-desc {
      font-size: 1.125rem;
      margin-bottom: 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .cta-desc {
      font-size: 1.25rem;
    }
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    flex-wrap: wrap;
  }

  @media (min-width: 640px) {
    .cta-actions {
      flex-direction: row;
    }
  }
</style>
