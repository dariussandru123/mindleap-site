---
import BlogCarousel from '@/components/blog/BlogCarousel';
import { supabase } from '@/lib/supabase';

type BlogPostDb = {
  slug: string;
  title: string;
  excerpt: string;
  read_time: string;
  date_label: string;
  date_published: string;
  author: string;
  icon: string;
  cover_image: string;
  cover_image_alt: string;
  published: boolean;
  content: string;
};

type Props = {
  post: BlogPostDb;
};

const { post } = Astro.props;

// Auto-generate TOC from content HTML
// Matches <section id="..."><h2>Text</h2> pattern used in blog posts
const tocRegex = /<section[^>]*id="([^"]*)"[^>]*>\s*<h2[^>]*>([^<]*)<\/h2>/g;
const toc: { id: string; label: string }[] = [];
let match;
while ((match = tocRegex.exec(post.content || '')) !== null) {
  toc.push({ id: match[1], label: match[2] });
}

// Fetch related posts
const { data: relatedData } = await supabase
  .from('blog_posts')
  .select('slug, title, excerpt, read_time, icon, published')
  .eq('published', true)
  .neq('slug', post.slug)
  .order('date_published', { ascending: false })
  .limit(6);

const relatedPosts = (relatedData || []).map((item) => ({
  slug: item.slug,
  title: item.title,
  excerpt: item.excerpt,
  readTime: item.read_time,
  icon: item.icon,
  published: item.published,
}));
---

<article class="blog-page">
  <header class="blog-hero">
    <div class="blog-hero-media" aria-hidden="true">
      <div class="blog-hero-fallback"></div>
      {post.cover_image && (
        <img
          src={post.cover_image}
          alt=""
          width="1920"
          height="800"
          loading="eager"
        />
      )}
    </div>
    <div class="blog-hero-scrim" aria-hidden="true"></div>
    <div class="blog-hero-grid" aria-hidden="true"></div>

    <div class="blog-hero-inner">
      <a href="/resurse#blog" class="blog-back">
        <i class="ti ti-arrow-left" aria-hidden="true"></i>
        Inapoi la resurse
      </a>
      <div class="blog-chip-row">
        <span class="blog-chip"><i class="ti ti-article" aria-hidden="true"></i> Blog</span>
        <span class="blog-chip blog-chip-muted">{post.read_time}</span>
      </div>
      <h1 class="blog-hero-title">{post.title}</h1>
      <p class="blog-hero-excerpt">{post.excerpt}</p>
      <div class="blog-meta-row">
        <span><i class="ti ti-user" aria-hidden="true"></i> {post.author}</span>
        <span><i class="ti ti-calendar" aria-hidden="true"></i> {post.date_label}</span>
      </div>
    </div>
  </header>

  <div class="blog-shell">
    <div class="blog-shell-glow" aria-hidden="true"></div>
    <div class="blog-grid">
      {toc.length > 0 && (
        <aside class="blog-toc" aria-label="Cuprins articol">
          <p class="blog-toc-label">Cuprins</p>
          <nav>
            {toc.map((item) => (
              <a href={`#${item.id}`}>{item.label}</a>
            ))}
          </nav>
        </aside>
      )}

      <div class="blog-article-body">
        {toc.length > 0 && (
          <details class="blog-toc-mobile">
            <summary>Cuprins articol</summary>
            <nav>
              {toc.map((item) => (
                <a href={`#${item.id}`}>{item.label}</a>
              ))}
            </nav>
          </details>
        )}

        <slot />
      </div>
    </div>
  </div>

  {relatedPosts.length > 0 && (
    <section class="blog-more" aria-label="Alte articole de blog">
      <BlogCarousel
        client:visible
        posts={relatedPosts}
        title="Continua lectura"
        subtitle="Alte articole care te-ar putea interesa"
      />
    </section>
  )}
</article>
